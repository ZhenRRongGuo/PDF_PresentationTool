{
  "name": "pdf-presenter",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side dual-monitor PDF presentation tool with phone remote control",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "check:offline": "node scripts/check-offline-assets.cjs",
    "desktop": "electron .",
    "dist:portable": "npm run build && npm run check:offline && electron-builder --win portable dir"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "express": "^4.21.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pdfpresentation.tool",
    "productName": "PDF Presentation Tool",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "dir", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false,
      "artifactName": "PDF-Presentation-Tool-Portable-${version}-${arch}.${ext}"
    }
  }
}
